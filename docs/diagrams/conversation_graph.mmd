---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	prepare(prepare)
	respond(respond)
	finish(finish)
	fail(fail)
	__end__([<p>__end__</p>]):::last
	__start__ --> prepare;
	prepare --> respond;
	respond -.-> fail;
	respond -.-> finish;
	fail --> __end__;
	finish --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
